<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Administration - BLAKFLAMME</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      color: #111;
    }

    header {
      background: #000;
      color: white;
      text-align: center;
      padding: 25px;
      border-bottom: 4px solid #e00000;
    }

    header h1 {
      margin: 0;
      color: #e00000;
    }

    .container {
      width: 92%;
      max-width: 1000px;
      margin: 30px auto;
    }

    .box {
      background: white;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,.08);
      margin-bottom: 20px;
    }

    .champ {
      margin-bottom: 15px;
    }

    .champ label {
      display: block;
      margin-bottom: 6px;
      font-weight: bold;
    }

    .champ input {
      width: 100%;
      padding: 12px;
      border: 1px solid #ccc;
      border-radius: 7px;
      font-size: 15px;
    }

    button {
      background: #e00000;
      color: white;
      border: none;
      padding: 12px 18px;
      border-radius: 7px;
      cursor: pointer;
      font-weight: bold;
    }

    button:hover {
      background: #b00000;
    }

    .cache {
      display: none;
    }

    .commande {
      border: 1px solid #ddd;
      border-left: 5px solid #e00000;
      border-radius: 8px;
      padding: 18px;
      margin-bottom: 15px;
      background: #fff;
    }

    .commande h3 {
      margin-top: 0;
    }

    .statut {
      display: inline-block;
      padding: 6px 10px;
      border-radius: 20px;
      background: #fff3cd;
      color: #856404;
      font-weight: bold;
    }

    .terminee {
      background: #d4edda;
      color: #155724;
    }

    .erreur {
      color: #c00000;
      font-weight: bold;
    }

    .succes {
      color: #087a24;
      font-weight: bold;
    }

    @media (max-width: 600px) {
      .container {
        width: 94%;
        margin: 20px auto;
      }

      .box {
        padding: 18px;
      }
    }
  </style>
</head>

<body>

<header>
  <h1>🔥 BLAKFLAMME</h1>
  <p>Espace administrateur</p>
</header>

<main class="container">

  <!-- CONNEXION ADMIN -->
  <section id="connexion-admin" class="box">

    <h2>🔐 Connexion administrateur</h2>

    <form id="form-admin">

      <div class="champ">
        <label for="admin-email">Email</label>
        <input
          type="email"
          id="admin-email"
          required
        >
      </div>

      <div class="champ">
        <label for="admin-password">Mot de passe</label>
        <div style="display:flex; gap:8px;">
  <input
    type="password"
    id="admin-password"
    required
    style="flex:1;"
  >

  <button
    type="button"
    id="voir-mot-de-passe"
    style="background:#000;"
  >
    👁️
  </button>
</div>
      </div>

      <button type="submit">
        Se connecter
      </button>

    </form>

    <p id="message-admin"></p>

  </section>


  <!-- TABLEAU ADMIN -->
  <section id="dashboard-admin" class="cache">
<div class="box">
  <h2>🛒 Gestion des produits</h2>
  <p>Ajouter, modifier ou supprimer les produits BLAKFLAMME.</p>

  <div class="champ">
    <label for="produit-nom">Nom du produit</label>
    <input
      type="text"
      id="produit-nom"
      placeholder="Exemple : Charbon 10 kg"
    >
  </div>

  <div class="champ">
    <label for="produit-prix">Prix (FCFA)</label>
    <input
      type="number"
      id="produit-prix"
      placeholder="Exemple : 2500"
    >
  </div>

  <div class="champ">
    <label for="produit-description">Description</label>
    <input
      type="text"
      id="produit-description"
      placeholder="Description du produit"
    >
  </div>

  <div class="champ">
    <label for="produit-image">Photo du produit</label>
    <input
      type="url"
      id="produit-image"
      placeholder="URL de la photo"
    >
  </div>

  <button onclick="ajouterProduit()">
    ➕ Ajouter le produit
  </button>

  <p id="message-produit"></p>
</div>

<div class="box">
  <h2>📋 Produits disponibles</h2>
  <div id="liste-produits">
    Chargement des produits...
  </div>
</div>
    <div class="box">

      <h2>📦 Commandes clients</h2>

      <p>
        Gestion des commandes BLAKFLAMME.
      </p>

      <button onclick="chargerCommandes()">
        🔄 Actualiser
      </button>

      <button
        onclick="deconnexionAdmin()"
        style="background:#000; margin-left:8px;"
      >
        Se déconnecter
      </button>

    </div>


    <div class="box">

      <div id="liste-commandes">
        Chargement des commandes...
      </div>

    </div>

  </section>

</main>


<script>

const token = localStorage.getItem("blakflamme_token");

const user = JSON.parse(
  localStorage.getItem("blakflamme_user") || "null"
);


const connexionAdmin =
  document.getElementById("connexion-admin");

const dashboardAdmin =
  document.getElementById("dashboard-admin");


/*
  CONNEXION
*/

document
  .getElementById("form-admin")
  .addEventListener("submit", async (event) => {

    event.preventDefault();

    const email =
      document.getElementById("admin-email").value;

    const password =
      document.getElementById("admin-password").value;

    try {

      const response = await fetch(
        "/api/auth/login",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            email,
            password
          })
        }
      );

      const data = await response.json();

      if (!response.ok) {

        document.getElementById("message-admin")
          .className = "erreur";

        document.getElementById("message-admin")
          .textContent = data.message;

        return;
      }

      /*
        Pour l'instant, cette première version
        utilise le même système de connexion.
      */

      localStorage.setItem(
        "blakflamme_token",
        data.token
      );

      localStorage.setItem(
        "blakflamme_user",
        JSON.stringify(data.user)
      );

      afficherDashboard();

    } catch (error) {

      document.getElementById("message-admin")
        .className = "erreur";

      document.getElementById("message-admin")
        .textContent =
        "Impossible de contacter le serveur.";

    }

  });


/*
  AFFICHER LE TABLEAU ADMIN
*/

function afficherDashboard() {

  connexionAdmin.classList.add("cache");

  dashboardAdmin.classList.remove("cache");

  chargerCommandes();
chargerProduits();
}


/*
  CHARGER LES COMMANDES
*/

async function chargerCommandes() {

  const liste =
    document.getElementById("liste-commandes");

  liste.innerHTML =
    "Chargement des commandes...";

  const adminToken =
    localStorage.getItem("blakflamme_token");

  try {

    const response = await fetch(
      "/api/orders/all",
      {
        headers: {
          "Authorization":
            "Bearer " + adminToken
        }
      }
    );

    const data = await response.json();

    if (!response.ok) {

      liste.innerHTML =
        `<p class="erreur">${data.message}</p>`;

      return;
    }

    if (!data.orders || data.orders.length === 0) {

      liste.innerHTML =
        "<p>Aucune commande pour le moment.</p>";

      return;
    }

    liste.innerHTML =
      data.orders.map(commande => `

        <div class="commande">

          <h3>
            📦 Commande #${commande.id}
          </h3>
<p>
  <strong>👤 Client :</strong>
  ${commande.client?.name || "Non renseigné"}
</p>

<p>
  <strong>📞 Téléphone :</strong>
  ${commande.client?.phone || "Non renseigné"}
</p>

<p>
  <strong>📧 Email :</strong>
  ${commande.client?.email || "Non renseigné"}
</p>          <p>
            <strong>Total :</strong>
            ${Number(commande.total)
              .toLocaleString("fr-FR")} FCFA
          </p>

          <p>
            <strong>Adresse :</strong>
            ${commande.deliveryAddress || "Non renseignée"}
          </p>
<p>
  <strong>🛒 Produits :</strong>
</p>

<ul>
  ${
    (commande.items || []).map(item => `
      <li>
        ${item.nom} × ${item.quantite}
        — ${(item.prix * item.quantite).toLocaleString("fr-FR")} FCFA
      </li>
    `).join("")
  }
</ul>
          <p>
            <strong>Statut :</strong>

            <span class="statut ${
              commande.status === "Terminée"
                ? "terminee"
                : ""
            }">
              ${commande.status}
            </span>
          </p>

          ${
            commande.status !== "Terminée"
              ? `
                <button
                  onclick="terminerCommande('${commande.id}')"
                >
                  ✅ Terminer la commande
                </button>
              `
              : `
                <p class="succes">
                  ✅ Commande terminée
                </p>
              `
          }

        </div>

      `).join("");

  } catch (error) {

    liste.innerHTML =
      `<p class="erreur">
        Impossible de charger les commandes.
      </p>`;

  }

}


/*
  TERMINER UNE COMMANDE
*/

async function terminerCommande(id) {

  const adminToken =
    localStorage.getItem("blakflamme_token");

  try {

    const response = await fetch(
      "/api/orders/" + id + "/complete",
      {
        method: "PATCH",
        headers: {
          "Authorization":
            "Bearer " + adminToken
        }
      }
    );

    const data = await response.json();

    if (!response.ok) {

      alert(data.message);

      return;
    }

    alert("Commande terminée avec succès.");

    chargerCommandes();

  } catch (error) {

    alert(
      "Erreur lors de la mise à jour de la commande."
    );

  }

}


/*
  DECONNEXION
*/
async function chargerProduits() {
  const liste = document.getElementById("liste-produits");

  try {
    const response = await fetch("/api/products");
    const produits = await response.json();

    if (!response.ok) {
      liste.innerHTML = "<p class='erreur'>Impossible de charger les produits.</p>";
      return;
    }

    if (produits.length === 0) {
      liste.innerHTML = "<p>Aucun produit disponible.</p>";
      return;
    }

    liste.innerHTML = produits.map(produit => `
      <div class="commande">
        <h3>${produit.name}</h3>
        <p><strong>Prix :</strong> ${produit.price} FCFA</p>
        <p>${produit.description || ""}</p>

        ${
          produit.image
            ? `<img src="${produit.image}" alt="${produit.name}" style="max-width:200px; border-radius:8px;">`
            : "<p>Aucune photo</p>"
        }

        <br><br>

        <button onclick="modifierProduit('${produit.id}')">
          ✏️ Modifier
        </button>

        <button
          onclick="supprimerProduit('${produit.id}')"
          style="background:#000; margin-left:8px;"
        >
          🗑️ Supprimer
        </button>
      </div>
    `).join("");

  } catch (error) {
    liste.innerHTML =
      "<p class='erreur'>Erreur de connexion au serveur.</p>";
  }
}


async function ajouterProduit() {
  const name = document.getElementById("produit-nom").value.trim();
  const price = document.getElementById("produit-prix").value;
  const description =
    document.getElementById("produit-description").value.trim();
  const image =
    document.getElementById("produit-image").value.trim();

  const message = document.getElementById("message-produit");

  if (!name || !price) {
    message.className = "erreur";
    message.textContent = "Le nom et le prix sont obligatoires.";
    return;
  }

  const adminToken = localStorage.getItem("blakflamme_token");

  try {
    const response = await fetch("/api/products", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Authorization": "Bearer " + adminToken
      },
      body: JSON.stringify({
        name,
        price,
        description,
        image
      })
    });

    const data = await response.json();

    if (!response.ok) {
      message.className = "erreur";
      message.textContent =
        data.message || "Erreur lors de l'ajout.";
      return;
    }

    message.className = "succes";
    message.textContent = "Produit ajouté avec succès.";

    document.getElementById("produit-nom").value = "";
    document.getElementById("produit-prix").value = "";
    document.getElementById("produit-description").value = "";
    document.getElementById("produit-image").value = "";

    chargerProduits();

  } catch (error) {
    message.className = "erreur";
    message.textContent = "Erreur de connexion au serveur.";
  }
}


async function supprimerProduit(id) {
  const confirmation = confirm(
    "Voulez-vous vraiment supprimer ce produit ?"
  );

  if (!confirmation) {
    return;
  }

  const adminToken = localStorage.getItem("blakflamme_token");

  try {
    const response = await fetch(
      "/api/products/" + id,
      {
        method: "DELETE",
        headers: {
          "Authorization": "Bearer " + adminToken
        }
      }
    );

    const data = await response.json();

    if (!response.ok) {
      alert(data.message || "Erreur lors de la suppression.");
      return;
    }

    alert("Produit supprimé avec succès.");

    chargerProduits();

  } catch (error) {
    alert("Erreur de connexion au serveur.");
  }
}


async function modifierProduit(id) {
  const nom = prompt("Nouveau nom du produit :");

  if (nom === null) {
    return;
  }

  const prix = prompt("Nouveau prix (FCFA) :");

  if (prix === null) {
    return;
  }

  const description = prompt("Nouvelle description :");

  if (description === null) {
    return;
  }

  const image = prompt("URL de la nouvelle photo :");

  if (image === null) {
    return;
  }

  const adminToken = localStorage.getItem("blakflamme_token");

  try {
    const response = await fetch(
      "/api/products/" + id,
      {
        method: "PUT",
        headers: {
          "Content-Type": "application/json",
          "Authorization": "Bearer " + adminToken
        },
        body: JSON.stringify({
          name: nom,
          price: prix,
          description,
          image
        })
      }
    );

    const data = await response.json();

    if (!response.ok) {
      alert(data.message || "Erreur lors de la modification.");
      return;
    }

    alert("Produit modifié avec succès.");

    chargerProduits();

  } catch (error) {
    alert("Erreur de connexion au serveur.");
  }
}
function deconnexionAdmin() {

  localStorage.removeItem("blakflamme_token");

  localStorage.removeItem("blakflamme_user");

  location.reload();

}

const boutonVoirMotDePasse =
  document.getElementById("voir-mot-de-passe");

const champMotDePasse =
  document.getElementById("admin-password");

boutonVoirMotDePasse.onclick = function () {

  if (champMotDePasse.type === "password") {

    champMotDePasse.type = "text";
    boutonVoirMotDePasse.textContent = "🙈";

  } else {

    champMotDePasse.type = "password";
    boutonVoirMotDePasse.textContent = "👁️";
  }
};
</script>

</body>
</html>